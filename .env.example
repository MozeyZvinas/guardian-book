# Guardian Book environment (spec 03 §7). Copy to .env; .env is git-ignored.
# Every group is optional: the app boots with none of these set and /healthz reports
# configured: false per group. Never point a local .env at a hosted database.
# Values are never logged.

# ── server ──────────────────────────────────────────────────────────────────────
# Railway injects PORT. Local default: 8080.
PORT=

# ── db ─────────────────────────────────────────────────────────────────────────
# Postgres connection string. Local (docker compose): postgres://guardian:guardian_dev_only@127.0.0.1:5433/guardian
DATABASE_URL=

# ── auth (Better Auth; wired in B02) ───────────────────────────────────────────
# Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The public origin of the app, e.g. http://localhost:8080 locally.
BETTER_AUTH_URL=

# ── meta (model gateway; wired in B03). Standard tier only (D24). ──────────────
# Model IDs ending in -contributor are refused in code.
META_API_KEY=
# Default: https://api.meta.ai/v1
META_BASE_URL=
# Default: muse-spark-1.3
META_MODEL=

# ── caps ───────────────────────────────────────────────────────────────────────
# Global daily spend cap in USD; the gateway refuses calls past it.
MODEL_DAILY_BUDGET_USD=
# Per-user daily model-call cap.
MODEL_USER_DAILY_CALLS=

# ── bucket (Railway Bucket, S3-compatible, private; presigned URLs ≤ 5 min) ────
BUCKET_ENDPOINT=
BUCKET_NAME=
BUCKET_ACCESS_KEY_ID=
BUCKET_SECRET_ACCESS_KEY=
BUCKET_REGION=

# ── sentry (optional) ──────────────────────────────────────────────────────────
SENTRY_DSN=

# ── evals only ─────────────────────────────────────────────────────────────────
# Read by the evaluation runner (B08), never by the app. Never set in the deployed app.
BENCHMARK_DIR=

# ── db extras (B02) ────────────────────────────────────────────────────────────
# Pending migrations run before the server listens (additive, idempotent). Set false to
# run them yourself with `pnpm db:migrate` (for example as a Railway pre-deploy command).
DB_MIGRATE_ON_BOOT=
# Dev only: the password every seeded demo person gets (`pnpm db:seed`; 8+ characters).
# Never commit a value.
SEED_PASSWORD=
# Admin CLI only: a directory OUTSIDE the repo with reviewed item JSON files
# (`pnpm content:load`, or pass the directory as the argument).
CONTENT_DIR=

# ── evals only (B03) ───────────────────────────────────────────────────────────
# `pnpm eval:dev`: a directory of case files OUTSIDE the repo (never committed).
EVAL_DIR=
# Where result files go. Default: evals/results/ at the repo root (git-ignored).
EVAL_OUT_DIR=
# Set to 1 to run the eval runner against a mocked model (no key, no spend).
EVAL_MOCK=
# B08 proof page (eval runner only, never the deployed app):
# a plain-words dataset label written into evals/results/latest.json, e.g.
# "development set: synthetic typed answers, scored by the implementer, not held out".
EVAL_DATASET_LABEL=
# Set to 1 only for a teacher-scored held-out run.
EVAL_HELD_OUT=
# "What doesn't work yet" lines for the proof page, separated by |
EVAL_NOT_YET=
# Where the integration run writes the change-the-ID results (default evals/results/privacy-harness.json).
EVAL_PRIVACY_FILE=
