{
  "name": "@guardian-book/api",
  "version": "0.1.0",
  "private": true,
  "description": "Guardian Book API: Express 5, serves /api, /healthz and the built web app.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "content:load": "tsx src/content/load.ts",
    "resources:load": "tsx src/resources/load.ts",
    "eval:dev": "tsx src/evals/run.ts",
    "smoke:live": "tsx src/evals/smoke.ts",
    "corpus:list": "tsx src/corpus/list.ts",
    "corpus:download": "tsx src/corpus/download.ts",
    "corpus:extract": "tsx src/corpus/extract.ts",
    "corpus:diagrams": "tsx src/corpus/upload-diagrams.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@guardian-book/shared": "workspace:*",
    "better-auth": "1.7.15",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "openai": "7.47.0",
    "pg": "8.23.1",
    "sharp": "^0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.11",
    "supertest": "7.3.1",
    "tsx": "4.23.15"
  }
}
