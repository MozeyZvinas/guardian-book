{
  "name": "guardian-book",
  "version": "0.1.0",
  "private": true,
  "description": "Guardian Book: a lifelong learning intelligence. One learner, three people, one Brain.",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && node scripts/check-token-colours.mjs",
    "test": "vitest run --project shared --project api --project web",
    "test:integration": "vitest run --project api-integration",
    "test:e2e": "playwright test",
    "build": "pnpm -r build",
    "start": "node apps/api/dist/server.js",
    "db:generate": "pnpm --filter @guardian-book/api db:generate",
    "db:migrate": "pnpm --filter @guardian-book/api db:migrate",
    "db:seed": "pnpm --filter @guardian-book/api db:seed",
    "content:load": "pnpm --filter @guardian-book/api content:load",
    "resources:load": "pnpm --filter @guardian-book/api resources:load",
    "eval:dev": "pnpm --filter @guardian-book/api eval:dev",
    "smoke:live": "pnpm --filter @guardian-book/api smoke:live",
    "eval:nsc": "pnpm --filter @guardian-book/api eval:nsc",
    "corpus:list": "pnpm --filter @guardian-book/api corpus:list",
    "corpus:download": "pnpm --filter @guardian-book/api corpus:download",
    "corpus:extract": "pnpm --filter @guardian-book/api corpus:extract",
    "corpus:diagrams": "pnpm --filter @guardian-book/api corpus:diagrams"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
